# 服务端监听端口 (默认: 3000)
PORT=3000

# 服务端内置 NovelAI API Token (选填)
# 配置后，前端登录页支持一键选择“使用系统内置 Key 登录”（Token 保存在服务端，前端无法窥探真实密钥）
# NOVELAI_TOKEN=pst-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 是否开启站点访问密钥验证 (true / false)
ENABLE_SITE_AUTH=true

# 多访问密钥与权限配置 (推荐)
# 格式: 密钥:权限 (all 允许使用超出免费额度的付费参数，free 严格限制仅限免费参数生图)
# 多个密钥用英文逗号分隔
ACCESS_KEYS=admin:all,guest123:free,vip_pass:all

# 单个站点访问密码 (兼容旧版写法，如果未配置 ACCESS_KEYS 则默认以此密码为全权限密钥)
ACCESS_PASSWORD=my_secret_passphrase_123

# 是否开启防嗅探双向加密 (true / false)
# 开启后，前端请求和后端返回的数据将经过位运算混淆，防止网络抓包和关键词嗅探
ENABLE_ENCRYPTION=false
VITE_ENABLE_ENCRYPTION=false
