# 服务端监听端口 (默认: 3000)
PORT=3000

# 是否开启站点访问密钥验证 (true / false)
# 若配置了 ACCESS_PASSWORD，可自动开启；也可设为 false 强制关闭
ENABLE_SITE_AUTH=true

# 站点访问密钥 / 进入网站密码 (用户访问任何内容与填写 API Token 前必须验证此密码)
ACCESS_PASSWORD=my_secret_passphrase_123

# 是否开启防嗅探双向加密 (true / false)
# 开启后，前端请求和后端返回的数据将经过位运算混淆，防止网络抓包和关键词嗅探
ENABLE_ENCRYPTION=false
VITE_ENABLE_ENCRYPTION=false
