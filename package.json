{
  "name": "novelai-proxy-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:server": "pnpm --filter server run dev",
    "dev:client": "pnpm --filter client run dev",
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:client\"",
    "build": "pnpm --filter client run build",
    "start": "pnpm --filter server run dev"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
